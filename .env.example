# Copy to .env and fill in real values. Never commit .env.

# Owner account, used only by scripts/ to create and load tables.
ADMIN_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/nl_sql_analytics

# Connection the app uses to run generated SQL. Currently the postgres account;
# swap in the read-only role from scripts/create_readonly_role.sql if it is set up later.
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/nl_sql_analytics
